# Configuração local do monorepo. Nunca versione o arquivo .env real.
CHARGEGRID_API_URL=https://your-api.example.com/v1
DATABASE_URL=postgresql+psycopg://chargegrid:CHANGE_ME@localhost:5432/chargegrid
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/chargegrid
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
CORS_ORIGINS=[]
# IA (OpenRouter). Vazio = IA desligada (regras e orientações locais). Nunca versione a chave real.
OPENROUTER_API_KEY=
